# ==========================================
# AI Interview Coach - Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_interview_coach

# Security
SECRET_KEY=super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==========================================
# AI Configuration (Option A: Gemini + Hugging Face)
# ==========================================

# Primary AI Inference Engine: NVIDIA NIM API (Primary Fast Inference Provider)
# Get your API key at: https://build.nvidia.com/
PRIMARY_LLM_PROVIDER=nvidia_nim
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_NIM_TIMEOUT=20.0
NVIDIA_NIM_MAX_RETRIES=2

# Secondary / Optional Cloud Fallback (Google Gemini API)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Secondary/Fallback LLM Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Models Configuration
PRIMARY_MODEL=gemini-1.5-flash
SECONDARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-3-5-sonnet

# RAG & Embedding Settings (Local Hugging Face - Free & Offline)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_MAX_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
